# .release.env
# Canopus — Local release configuration
#
# This file is gitignored. Each developer who performs releases configures
# their own NFS mount path here. Do not commit this file.
#
# Copy this file to .release.env and set NFS_RELEASE_PATH to the mounted
# network share directory where Canopus installers should be published.
#
# Example (Linux/macOS NFS mount):
#   NFS_RELEASE_PATH=/mnt/nfs/releases/canopus
#
# Example (macOS automount):
#   NFS_RELEASE_PATH=/Volumes/Engineering/releases/canopus

NFS_RELEASE_PATH=/mnt/nfs/releases/canopus
