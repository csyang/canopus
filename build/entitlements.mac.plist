<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  build/entitlements.mac.plist
  Canopus — macOS Hardened Runtime Entitlements

  Required for notarisation (distribution outside the Mac App Store).
  The JIT entitlement is needed by Electron's V8 engine.
  The allow-unsigned-executable-memory entitlement is required by elkjs
  which uses WebAssembly internally.
-->
<plist version="1.0">
  <dict>
    <!-- Allow JIT compilation — required by V8 / Electron -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory — required by WebAssembly (elkjs) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow reading/writing arbitrary files the user opens -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow dyld environment variables (Electron requirement) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Disable library validation — required for certain Electron internals -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
